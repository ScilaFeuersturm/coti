# Copiá este archivo como .env y completá lo que necesites. Nunca subas .env a git.

PORT=3456

# En producción: NODE_ENV=production (desactiva la cuenta demo, el reset y el "adelantar 48hs",
# y marca la cookie de sesión como Secure).
# NODE_ENV=production

# URL pública con la que se arman los links /p/... y las notificaciones de Mercado Pago.
# PUBLIC_BASE_URL=https://app.tudominio.com

# Si corrés detrás de un proxy (Render, Nginx...) para leer la IP real y https.
# TRUST_PROXY=1

# --- Mercado Pago (Checkout Pro) ---
# Access Token de tu aplicación en https://www.mercadopago.com.ar/developers/panel
# Para probar usá el de credenciales de prueba (empieza con TEST-).
# MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (panel de la app > Webhooks) para verificar la firma x-signature.
# MP_WEBHOOK_SECRET=
# Moneda en la que cobra Mercado Pago y cotización para convertir desde la moneda del taller (USD).
# MP_CURRENCY=ARS
# MP_FX_RATE=1200
