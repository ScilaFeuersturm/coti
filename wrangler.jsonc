{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coti",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Archivos de la app (HTML, CSS, JS, íconos). /api/* y /p/* pasan primero por el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Base de datos D1 (cuenta priscilaayeleng.developer, región ENAM).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coti",
      "database_id": "f03da030-9894-4a6a-ad44-579951cdaf88",
      "migrations_dir": "migrations"
    }
  ],

  // Variables no secretas. Las claves (MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET) van con:
  //   npx wrangler secret put MP_ACCESS_TOKEN
  // Para desarrollo local se pisan con el archivo .dev.vars (ver .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "production",
    "MP_CURRENCY": "ARS"
  }
}
